#!/usr/bin/env python3
"""Launch the optional v2 pilot with explicitly separated artifact and course Python."""
import argparse
import os
from pathlib import Path
import subprocess
import sys


def main():
    root = Path(__file__).resolve().parents[1]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--platform-python', required=True, help='Absolute installed pilot artifact venv Python (not a source checkout).')
    parser.add_argument('--kernel-python', default=str(root / '.venv/bin/python'), help='Course-only Python; defaults to this course .venv/bin/python.')
    parser.add_argument('--state-dir', required=True, help='External learner state directory, outside the course.')
    parser.add_argument('--port', type=int, default=8765)
    args = parser.parse_args()
    for name in ('platform_python', 'kernel_python'):
        value = Path(getattr(args, name))
        # Never resolve interpreter symlinks: that would lose venv selection.
        if not value.is_absolute() or not value.is_file() or not os.access(value, os.X_OK):
            parser.error(f'--{name.replace("_", "-")} must name an executable absolute Python path; install the pilot artifact and run uv sync in the course.')
    state = Path(args.state_dir).expanduser().resolve()
    if state.is_relative_to(root) or root.is_relative_to(state):
        parser.error('--state-dir must be a separate directory outside the course, not its ancestor.')
    probe = subprocess.run([args.platform_python, '-m', 'courseweave', 'launch', '--help'], capture_output=True, text=True)
    if probe.returncode or '--kernel-python' not in probe.stdout:
        parser.error('Incompatible pilot artifact: install the schema-v2 wheel with launch --kernel-python support in the explicit platform venv. See study/COURSEWEAVE-PILOT.md.')
    if Path(args.platform_python).absolute() == Path(args.kernel_python).absolute():
        parser.error('Use separate platform artifact and course kernel environments.')
    print(f'Platform artifact: {args.platform_python}\nCourse kernel: {args.kernel_python}\nExternal learner state: {state}', file=sys.stderr, flush=True)
    os.execv(args.platform_python, [args.platform_python, '-m', 'courseweave', 'launch', '--course-root', str(root), '--kernel-python', args.kernel_python, '--state-dir', str(state), '--port', str(args.port)])


if __name__ == '__main__':
    main()
