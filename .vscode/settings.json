{
  "workbench.editorAssociations": {
    "**/sessions/*/toy.py": "marimo-notebook",
    "**/labs/app.py": "marimo-notebook",
    "*.md": "vscode.markdown.preview.editor"
  },
  // Matching .github/instructions/*.instructions.md files and linked policy.
  "chat.includeApplyingInstructions": true,
  "chat.includeReferencedInstructions": true,
  // This separate setting concerns .github/copilot-instructions.md, if present.
  "github.copilot.chat.codeGeneration.useInstructionFiles": true
}
